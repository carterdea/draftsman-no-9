# Draftsman No. 9 - non-secret defaults
# Copy to `.env` for shared local defaults.
# Put real secrets in untracked `.env.local`.

# Runtime
NODE_ENV=development
PORT=3000
WORKER_POLL_MS=5000

# Infrastructure (local docker-compose defaults)
DATABASE_URL=postgres://draftsman:draftsman@localhost:5432/draftsman
REDIS_URL=redis://localhost:6379

# BullMQ queue names
JOBS_QUEUE_NAME=draftsman:jobs
NOTIFICATIONS_QUEUE_NAME=draftsman:notifications

# Artifact storage (dev default is local filesystem)
ARTIFACT_STORAGE_PROVIDER=local_fs
ARTIFACT_LOCAL_DIR=./.draftsman-artifacts
ARTIFACT_R2_BUCKET=draftsman-artifacts-dev
ARTIFACT_R2_ENDPOINT=
ARTIFACT_R2_ACCESS_KEY_ID=
ARTIFACT_R2_SECRET_ACCESS_KEY=

# Integrations (set in .env.local / secret manager)
TRELLO_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
INTERNAL_API_BEARER_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
